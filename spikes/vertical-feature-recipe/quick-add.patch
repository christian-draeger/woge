+package example.todo
+
+import org.jsoup.Jsoup
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.springframework.boot.SpringApplication
+import org.springframework.boot.web.server.context.ConfigurableWebServerApplicationContext
+import java.net.URI
+import java.net.URLEncoder
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.nio.charset.StandardCharsets.UTF_8
+import java.time.Duration
+
+class QuickAddApplicationTest {
+    @Test
+    fun `native quick add validates then redirects to the existing list`() {
+        todos.reset()
+        SpringApplication.run(Application::class.java, "--server.port=0", "--logging.level.root=WARN").use { context ->
+            val port = requireNotNull((context as ConfigurableWebServerApplicationContext).webServer).port
+            val origin = "http://127.0.0.1:$port"
+            val client = HttpClient.newHttpClient()
+
+            fun get(path: String) = client.send(
+                HttpRequest.newBuilder(URI.create(origin + path)).timeout(Duration.ofSeconds(10)).GET().build(),
+                HttpResponse.BodyHandlers.ofString(),
+            )
+
+            val formResponse = get("/quick-add")
+            assertEquals(200, formResponse.statusCode())
+            val form = Jsoup.parse(formResponse.body())
+            assertEquals("Quick add todo", form.selectFirst("h1")?.text())
+            assertEquals("post", form.selectFirst("form")?.attr("method"))
+            val action = requireNotNull(form.selectFirst("form")).attr("action")
+            assertEquals("quick-add-title", form.selectFirst("label")?.attr("for"))
+            assertTrue(form.select("script").isEmpty())
+
+            fun submit(value: String, requestOrigin: String = origin) = client.send(
+                HttpRequest.newBuilder(URI.create(origin + action)).timeout(Duration.ofSeconds(10))
+                    .header("Origin", requestOrigin)
+                    .header("Content-Type", "application/x-www-form-urlencoded")
+                    .POST(HttpRequest.BodyPublishers.ofString("title=" + URLEncoder.encode(value, UTF_8)))
+                    .build(),
+                HttpResponse.BodyHandlers.ofString(),
+            )
+
+            assertEquals(403, submit("Rejected title", "https://other.example").statusCode())
+            val invalid = submit("   ")
+            assertEquals(400, invalid.statusCode())
+            val rejection = Jsoup.parse(invalid.body())
+            assertEquals("   ", rejection.selectFirst("#quick-add-title")?.attr("value"))
+            assertEquals("true", rejection.selectFirst("#quick-add-title")?.attr("aria-invalid"))
+            assertEquals("#quick-add-title", rejection.selectFirst("#quick-add-errors a")?.attr("href"))
+            assertTrue(todos.snapshot().todos.isEmpty())
+
+            val valid = submit("  Read <HTML>  ")
+            assertEquals(303, valid.statusCode())
+            val location = valid.headers().firstValue("Location").orElseThrow()
+            assertEquals("/", location)
+            val redirected = get(location)
+            assertEquals(200, redirected.statusCode())
+            assertTrue(redirected.body().contains("Read &lt;HTML&gt;"))
+            assertEquals(listOf("Read <HTML>"), todos.snapshot().todos.map { it.title })
+        }
+    }
+}
