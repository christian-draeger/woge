+package example.todo
+
+import dev.woge.host.CsrfVerification
+import dev.woge.host.FailureCategory
+import dev.woge.host.FormDecoder
+import dev.woge.host.FormElementId
+import dev.woge.host.FormError
+import dev.woge.host.FormErrors
+import dev.woge.host.FormValues
+import dev.woge.host.PageResult
+import dev.woge.host.PageUseCase
+import dev.woge.host.RequestContext
+import dev.woge.host.ResponseMetadata
+import dev.woge.host.ResponseStatus
+import dev.woge.host.WogeAction
+import dev.woge.host.WogeRoute
+import dev.woge.host.actionForm
+import dev.woge.host.failure
+import dev.woge.host.formErrorSummary
+import dev.woge.host.formField
+import dev.woge.host.formFieldErrors
+import dev.woge.host.htmlPage
+import dev.woge.host.redirect
+import dev.woge.html.body
+import dev.woge.html.button
+import dev.woge.html.h1
+import dev.woge.html.head
+import dev.woge.html.html
+import dev.woge.html.input
+import dev.woge.html.label
+import dev.woge.html.main
+import dev.woge.html.title
+import kotlinx.serialization.Serializable
+
+@WogeRoute("/quick-add")
+internal data object QuickAddInput
+
+@Serializable
+internal data class QuickAddTodo(val title: String)
+
+internal val quickAddDecoder = FormDecoder(QuickAddTodo.serializer())
+private val quickAddTitle = quickAddDecoder.field(QuickAddTodo::title, FormElementId.of("quick-add-title"))
+private val quickAddSummary = FormElementId.of("quick-add-errors")
+
+internal val quickAddPage = PageUseCase<QuickAddInput> {
+    quickAddDocument(FormErrors(FormValues.EMPTY, emptyList()), ResponseStatus.OK)
+}
+
+@WogeAction("quick-add-todo")
+internal suspend fun quickAddTodo(command: QuickAddTodo, context: RequestContext): PageResult {
+    if (context.csrf != CsrfVerification.VERIFIED) return failure(FailureCategory.FORBIDDEN, context.correlationId)
+    val title = command.title.trim()
+    if (title.isEmpty() || title.length > MAX_TITLE_LENGTH) {
+        val errors = FormErrors(
+            FormValues.of(mapOf(quickAddTitle.name to listOf(command.title))),
+            listOf(FormError(quickAddTitle, "Enter a title of 1 to $MAX_TITLE_LENGTH characters.")),
+        )
+        return quickAddDocument(errors, ResponseStatus.BAD_REQUEST)
+    }
+    todos.add(title)
+    return redirect(TodosRoute.url(TodosInput()), ResponseStatus.SEE_OTHER)
+}
+
+private fun quickAddDocument(errors: FormErrors<QuickAddTodo>, status: ResponseStatus): PageResult.Document =
+    htmlPage(ResponseMetadata(status = status)) {
+        doctype()
+        html(attributes = { attribute("lang", "en") }) {
+            head { title("Quick add todo") }
+            body {
+                main {
+                    h1 { text("Quick add todo") }
+                    formErrorSummary(errors, quickAddSummary, "Check your todo")
+                    actionForm(QuickAddTodoAction) {
+                        label(attributes = { attribute("for", quickAddTitle.id.value) }) { text("Todo title") }
+                        input(attributes = {
+                            formField(quickAddTitle, errors)
+                            attribute("value", errors.value(quickAddTitle).orEmpty())
+                            attribute("maxlength", MAX_TITLE_LENGTH.toString())
+                            boolean("required")
+                        })
+                        formFieldErrors(quickAddTitle, errors)
+                        button { text("Add todo") }
+                    }
+                }
+            }
+        }
+    }
